# Copy this file to .env (which stays on your machine and out of Git) and fill it in.
# Your ProtonVPN WireGuard private key: account.proton.me -> VPN -> WireGuard -> create a configuration,
# then copy the value after "PrivateKey =".
WIREGUARD_PRIVATE_KEY=
# Where the VPN comes out; FREE_ONLY=on in docker-compose.yml's environment if you have a free Proton plan.
SERVER_COUNTRIES=Netherlands
